generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  email        String         @unique
  passwordHash String         @map("password_hash")
  status       String         @default("ACTIVE")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @map("updated_at")

  events         Event[]
  notifications  Notification[]
  apiKeys        ApiKey[]

  @@map("users")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  name      String
  keyPrefix String    @unique @map("key_prefix")
  keyHash   String    @map("key_hash")
  isActive  Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("api_keys")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid

  userId      String   @db.Uuid

  eventKey    String
  name        String
  description String?

  subject     String
  body        String

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  notifications Notification[]

  @@unique([userId, eventKey])
  @@map("events")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid

  channel   String[]  @default([]) // "EMAIL", "SMS", "PUSH", "WHATSAPP"
  recipient String   // Stores the email address, phone number, or token directly

  status    String   // "QUEUED", "PROCESSING", "SENT", "FAILED"
  provider  String?  // Tracks who sent it: "TWILIO", "RESEND", "SENDGRID"
  jobId     String?  @map("job_id") // Links directly to your BullMQ Redis Job ID

  payload   Json     @db.JsonB // Dynamic context (e.g., custom variables for template hydration)

  sentAt    DateTime? @map("sent_at")
  failedAt  DateTime? @map("failed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
  logs  NotificationLog[]

  @@index([userId])
  @@index([eventId])
  @@index([jobId]) // Allows you to quickly update statuses via BullMQ event listeners
  @@map("notifications")
}


model NotificationLog {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid

  attemptNumber  Int      @default(1) @map("attempt_number")

  response       Json?
  errorMessage   String?  @map("error_message")

  createdAt      DateTime @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId],references: [id])

  @@map("notification_logs")
}
